{
  "expo": {
    "name": "Modas Nicolas",
    "slug": "appjorge",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "appjorge",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "expo-document-picker",
      "expo-font",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "android": {
      "package": "com.appjorge.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "bundleIdentifier": "com.appjorge.mobile",
      "supportsTablet": true,
      "usesIcloudStorage": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2d4a416-7bd0-456e-a2b1-9e0852893716"
      }
    },
    "owner": "sergioalv15"
  }
}
